{
  "name": "nestor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "apply:eval": "node packages/ai-evals/scripts/run-apply-replay.mjs",
    "dev": "node scripts/run-turbo.mjs dev --parallel",
    "desktop:dev": "pnpm --filter @nestor/desktop dev",
    "desktop:start": "pnpm --filter @nestor/desktop start",
    "build": "node scripts/run-turbo.mjs build",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "node scripts/run-turbo.mjs lint",
    "structure:check": "node scripts/check-structure.mjs",
    "source-generic:check": "node scripts/check-source-generic-discovery.mjs",
    "hotspots": "node scripts/repo-hotspots.mjs",
    "ai:benchmark": "node packages/ai-evals/scripts/run.mjs",
    "lsp:typescript": "typescript-language-server --stdio",
    "typecheck": "node scripts/run-turbo.mjs typecheck",
    "verify:quick": "node scripts/check-source-generic-discovery.mjs && node scripts/check-structure.mjs && node scripts/run-turbo.mjs lint && node scripts/run-turbo.mjs typecheck",
    "verify:affected": "node scripts/check-source-generic-discovery.mjs && node scripts/check-structure.mjs && node scripts/run-turbo.mjs lint typecheck test --affected",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:desktop": "node scripts/validate-package.mjs desktop",
    "validate:job-finder": "node scripts/validate-package.mjs job-finder",
    "validate:browser-agent": "node scripts/validate-package.mjs browser-agent",
    "validate:browser-runtime": "node scripts/validate-package.mjs browser-runtime",
    "validate:contracts": "node scripts/validate-package.mjs contracts",
    "knip": "knip",
    "test": "pnpm test:correctness",
    "test:unit": "pnpm test:correctness",
    "test:smoke": "vitest run --dir packages/contracts/src",
    "test:correctness": "vitest run --maxWorkers=4 --minWorkers=4",
    "test:coverage": "vitest run --coverage --maxWorkers=4 --minWorkers=4",
    "search:eval": "node packages/ai-evals/scripts/run-search-relevance.mjs",
    "perf": "node .claude/skills/verify-nestor/bin/lib/perf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.1.4",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "globals": "^14.0.0",
    "knip": "^6.4.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "typescript-language-server": "^4.4.0",
    "vitest": "^3.1.4"
  }
}
