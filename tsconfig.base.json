{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@nestor/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@nestor/ai-evals": ["packages/ai-evals/src/index.ts"],
      "@nestor/ai-providers": ["packages/ai-providers/src/index.ts"],
      "@nestor/browser-agent": ["packages/browser-agent/src/index.ts"],
      "@nestor/browser-runtime": ["packages/browser-runtime/src/index.ts"],
      "@nestor/contracts": ["packages/contracts/src/index.ts"],
      "@nestor/core": ["packages/core/src/index.ts"],
      "@nestor/db": ["packages/db/src/index.ts"],
      "@nestor/db/job-store": ["packages/db/src/job-store/job-store.ts"],
      "@nestor/job-list-policy": ["packages/job-list-policy/src/index.ts"],
      "@nestor/job-list-policy/identity": [
        "packages/job-list-policy/src/job-identity.ts"
      ],
      "@nestor/job-list-policy/text": [
        "packages/job-list-policy/src/shared.ts"
      ],
      "@nestor/job-list-policy/ordering": [
        "packages/job-list-policy/src/ordering.ts"
      ],
      "@nestor/job-list-policy/sources": [
        "packages/job-list-policy/src/sources.ts"
      ],
      "@nestor/job-list-policy/tie-break-reason": [
        "packages/job-list-policy/src/tie-break-reason.ts"
      ],
      "@nestor/knowledge-base": ["packages/knowledge-base/src/index.ts"],
      "@nestor/job-finder/assistant-attention": [
        "packages/job-finder/src/assistant/attention.ts"
      ],
      "@nestor/job-finder/discovery-ordering": [
        "packages/job-finder/src/discovery-ordering.ts"
      ],
      "@nestor/job-finder/discovery-result-bands": [
        "packages/job-finder/src/discovery-result-bands.ts"
      ],
      "@nestor/job-finder/resume-record-identity": [
        "packages/job-finder/src/resume-record-identity.ts"
      ],
      "@nestor/job-finder/plan-safeguard-pauses": [
        "packages/job-finder/src/plan-safeguard-pauses.ts"
      ],
      "@nestor/job-finder/source-health": [
        "packages/job-finder/src/source-health.ts"
      ],
      "@nestor/job-finder/source-instruction-review": [
        "packages/job-finder/src/source-instruction-review.ts"
      ],
      "@nestor/job-finder": ["packages/job-finder/src/index.ts"],
      "@nestor/live-assistant": ["packages/live-assistant/src/index.ts"],
      "@nestor/os-integration": ["packages/os-integration/src/index.ts"],
      "@nestor/testing": ["packages/testing/src/index.ts"]
    }
  }
}
