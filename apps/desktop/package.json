{
  "name": "@nestor/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Job Finder and Live Assistant desktop workspace.",
  "author": "Nestor contributors",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "qa": "node ./scripts/agent-qa/cli.mjs",
    "qa:test": "node --test ./scripts/agent-qa/support.test.mjs",
    "dev": "node ./scripts/prepare-resume-parser-sidecar.mjs --mode best-effort && electron-vite dev --ignoreConfigWarning",
    "build": "node ./scripts/prepare-resume-parser-sidecar.mjs --mode best-effort && electron-vite build",
    "start": "node ./scripts/prepare-resume-parser-sidecar.mjs --mode best-effort && electron-vite preview --ignoreConfigWarning",
    "package:dir": "pnpm run prepare:resume-parser-sidecar -- --target win32-x64 && pnpm build && electron-builder --config electron-builder.json --dir",
    "package:win": "pnpm run prepare:resume-parser-sidecar -- --target win32-x64 && pnpm build && electron-builder --config electron-builder.json --win",
    "lint": "eslint electron.vite.config.ts src --ext .ts,.tsx",
    "prepare:resume-parser-sidecar": "node ./scripts/prepare-resume-parser-sidecar.mjs --mode required",
    "prepare:resume-parser-sidecar:matrix": "node ./scripts/prepare-resume-parser-sidecar.mjs --mode required --target win32-x64,darwin-arm64,darwin-x64,linux-x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:embedded-browser": "node ./scripts/test-embedded-browser.mjs",
    "benchmark:resume-import": "pnpm build && node ./scripts/run-resume-import-benchmark.mjs",
    "benchmark:resume-quality": "pnpm build && node ./scripts/run-resume-quality-benchmark.mjs",
    "ui:capture": "pnpm build && node ./scripts/capture-ui.mjs",
    "ui:profile-copilot-preferences": "pnpm build && node ./scripts/capture-profile-copilot-preferences.mjs",
    "ui:source-sign-in-prompts": "pnpm build && node ./scripts/capture-source-sign-in-prompts.mjs",
    "ui:resume-import": "pnpm build && node ./scripts/capture-resume-import.mjs",
    "ui:profile-baseline": "pnpm build && node ./scripts/capture-profile-baseline.mjs --snapshot ./test-fixtures/job-finder/profile-baseline-workspace.json",
    "ui:profile-setup": "pnpm build && node ./scripts/capture-profile-setup.mjs",
    "ui:applications-copilot-review": "pnpm build && node ./scripts/capture-applications-copilot-review.mjs",
    "ui:applications-recovery": "pnpm build && node ./scripts/capture-applications-recovery.mjs",
    "ui:applications-consent-states": "pnpm build && node ./scripts/capture-applications-consent-states.mjs",
    "ui:applications-queue-recovery": "pnpm build && node ./scripts/capture-applications-queue-recovery.mjs",
    "seed:job-finder-demo": "node ./scripts/seed-job-finder-demo-workspace.mjs",
    "ui:live-assistant": "pnpm build && node ./scripts/capture-live-assistant.mjs",
    "ui:live-assistant:fast": "pnpm build && node ./scripts/capture-live-assistant-fast.mjs",
    "ui:live-assistant:fast:built": "node ./scripts/capture-live-assistant-fast.mjs",
    "ui:live-assistant-basic:built": "node ./scripts/capture-live-assistant-basic.mjs",
    "ui:live-assistant-popups": "pnpm build && node ./scripts/capture-live-assistant-basic.mjs",
    "ui:live-assistant-popups:built": "node ./scripts/capture-live-assistant-basic.mjs",
    "audit:job-finder-live": "node ./scripts/audit-job-finder-live.mjs",
    "test:live-assistant-audio:built": "node ./scripts/test-live-assistant-audio.mjs",
    "test:live-assistant-live-system-audio": "pnpm build && node ./scripts/test-live-assistant-live-system-audio.mjs",
    "test:live-assistant-live-system-audio:built": "node ./scripts/test-live-assistant-live-system-audio.mjs",
    "test:job-finder-prepare-only": "pnpm build && node ./scripts/test-job-finder-prepare-only.mjs",
    "test:job-finder-prepare-only:built": "node ./scripts/test-job-finder-prepare-only.mjs",
    "test:job-finder-complete-flow": "pnpm build && node ./scripts/test-job-finder-complete-flow.mjs",
    "test:job-finder-complete-flow:built": "node ./scripts/test-job-finder-complete-flow.mjs",
    "test:job-finder-ashby-flow": "pnpm build && node ./scripts/test-job-finder-ashby-flow.mjs",
    "test:job-finder-ashby-flow:built": "node ./scripts/test-job-finder-ashby-flow.mjs",
    "test:job-finder-workday-flow": "pnpm build && node ./scripts/test-job-finder-workday-flow.mjs",
    "test:job-finder-workday-flow:built": "node ./scripts/test-job-finder-workday-flow.mjs",
    "test:job-finder-ats-matrix": "pnpm build && pnpm test:job-finder-complete-flow:built && pnpm test:job-finder-ashby-flow:built && pnpm test:job-finder-workday-flow:built",
    "ui:live-assistant-protection": "pnpm build && node ./scripts/capture-live-assistant-protection.mjs",
    "ui:apply-queue-controls": "pnpm build && node ./scripts/capture-apply-queue-controls.mjs",
    "ui:original-cv-flow": "pnpm build && node ./scripts/capture-original-cv-flow.mjs",
    "ui:resume-workspace": "pnpm build && node ./scripts/capture-resume-workspace.mjs",
    "ui:resume-workspace-dirty": "pnpm build && node ./scripts/capture-resume-workspace-dirty.mjs",
    "ui:action-inbox": "pnpm build && node ./scripts/capture-action-inbox.mjs",
    "ui:action-inbox:built": "node ./scripts/capture-action-inbox.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mozilla/readability": "^0.5.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@nestor/ai-providers": "workspace:*",
    "@nestor/browser-runtime": "workspace:*",
    "@nestor/contracts": "workspace:*",
    "@nestor/db": "workspace:*",
    "@nestor/live-assistant": "workspace:*",
    "@nestor/job-finder": "workspace:*",
    "@nestor/knowledge-base": "workspace:*",
    "@nestor/os-integration": "workspace:*",
    "chromium-bidi": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^5.4.54",
    "playwright": "^1.63.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "ws": "8",
    "@nestor/core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.2.2",
    "vite": "^6.2.0"
  },
  "build": {
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/resume-parser-sidecar",
        "to": "resume-parser-sidecar",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
