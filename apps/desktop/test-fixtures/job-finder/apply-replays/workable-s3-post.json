    "bucket": "synthetic-workable-files",
    "X-Amz-Algorithm": "AWS4-HMAC-SHA256",
    "X-Amz-Credential": "EXAMPLEUPLOADKEY12345/20990101/local-test-1/s3/aws4_request",
    "X-Amz-Date": "20990101T000000Z",
    "key": "tmp/ttl-1d/production/0a1b2c3d-4e5f-4789-8bcd-ef0123456789",
    "X-Amz-Signature": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "policy": {
    "expiration": "2099-01-01T01:00:00Z",
    "conditions": [
      ["starts-with", "$utf8", ""],
      [
        "eq",
