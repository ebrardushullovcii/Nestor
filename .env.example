# Recommended mixed OpenCode Go configuration. The same Go key can serve both
# routes; keep it local and never commit it.
NESTOR_AI_API_KEY=
NESTOR_AI_BASE_URL=https://opencode.ai/zen/go/v1
NESTOR_AI_MODEL=muse-spark-1.3-contributor
NESTOR_AI_API_MODE=responses
NESTOR_AI_REASONING_EFFORT=xhigh
# Resume writing and full listing reads use the effort above. Search turns,
# page reads, fit batches, fact checks and form turns have their own
# variables (NESTOR_AI_SEARCH_/PAGE_READ_/FIT_/CLAIM_CHECK_/APPLY_/
# LISTING_READ_REASONING_EFFORT); see docs/AI_PROVIDER_SETUP.md. This one
# covers other tool-calling work (import sections, assistants, letters).
NESTOR_AI_AGENT_REASONING_EFFORT=low

# Dedicated model route for aggressive resume tailoring. The raw Go model ID is
# deepseek-v4.1-flash, verified against https://opencode.ai/zen/go/v1/models.
# Reasoning effort is read from its own env var so it is always applied.
NESTOR_AI_AGGRESSIVE_MODEL=deepseek-v4.1-flash
NESTOR_AI_AGGRESSIVE_API_MODE=chat_completions
NESTOR_AI_AGGRESSIVE_REASONING_EFFORT=high

# Image work also runs on Muse Spark through OpenCode Go's Responses endpoint.
NESTOR_AI_VISION_BASE_URL=https://opencode.ai/zen/go/v1
NESTOR_AI_VISION_MODEL=muse-spark-1.3-contributor
NESTOR_AI_VISION_API_MODE=responses
NESTOR_AI_VISION_REASONING_EFFORT=xhigh

# Optional local Codex-subscription proxy for evaluation only:
# npx --yes openai-oauth@2.0.0 --host 127.0.0.1 --port 10531 --detach
# NESTOR_AI_API_KEY=unused
# NESTOR_AI_BASE_URL=http://127.0.0.1:10531/v1
# Keep Responses mode, Luna/high, and loopback-only binding. See
# docs/AI_PROVIDER_SETUP.md. Use the official OpenAI API for production.
#
# Live Assistant uses Muse Spark for cue text and for screenshots.
# Neither route transcribes audio; keep transcription on local Whisper or an
# explicit audio model.
# NESTOR_INTERVIEW_AI_MODEL=muse-spark-1.3-contributor
# NESTOR_INTERVIEW_AI_API_MODE=responses
# NESTOR_INTERVIEW_REASONING_EFFORT=xhigh
# NESTOR_INTERVIEW_VISION_MODEL=muse-spark-1.3-contributor
# NESTOR_INTERVIEW_VISION_API_MODE=responses
# NESTOR_INTERVIEW_VISION_REASONING_EFFORT=xhigh

# Optional free local Live Assistant STT for microphone and system-audio chunks.
# Point the local-command provider at the wrapper below, then provide a Whisper.cpp
# executable and ggml model. Raw chunks are converted with FFmpeg, transcribed
# locally, and removed from temp storage after each provider call.
# NESTOR_INTERVIEW_LOCAL_STT_COMMAND=pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/live-assistant-local-stt.ps1 -Audio {audio} -Output {output} -Language {language} -Source {source}
# NESTOR_INTERVIEW_LOCAL_STT_LABEL=Local Whisper.cpp
# NESTOR_INTERVIEW_WHISPER_CPP_EXE=
# NESTOR_INTERVIEW_WHISPER_CPP_MODEL=
# NESTOR_FFMPEG_PATH=

# Optional reliability knobs shared by every model route (ADR 0020). Requests
# stream by default; liveness is measured as silence, not total time.
# NESTOR_AI_TIMEOUT_MS=300000          # total budget per ordinary model call
# NESTOR_AI_RESUME_TIMEOUT_MS=600000   # total budget for resume import/draft calls
# NESTOR_AI_IDLE_TIMEOUT_MS=120000     # silence before an attempt is presumed dead and retried
# NESTOR_AI_MAX_ATTEMPTS=5             # attempts per call, including the first
# NESTOR_AI_RETRY_BASE_DELAY_MS=1000   # first backoff delay; doubles up to 20s, honours Retry-After
# NESTOR_AI_STREAMING=1                # set 0 to send plain JSON requests (no liveness signal)
# Optional: generic resume-vision provider timeout in milliseconds (default: 600000 / 10 minutes).
# The text import path still completes gracefully if the provider times out.
# NESTOR_RESUME_VISION_TIMEOUT_MS=600000
# Optional: desktop image-adapter timeout in milliseconds (default: 600000); honored by local page image generation when set.
# NESTOR_RESUME_VISION_IMAGE_TIMEOUT_MS=600000

# Browser Agent — enable live browser-assisted discovery and supported apply flows in the embedded browser
NESTOR_BROWSER_AGENT=1

# Optional: use a separate Chrome profile instead of the embedded browser
# NESTOR_BROWSER_HOST=external

# External host only: path to Chrome executable (auto-detected if unset)
# NESTOR_CHROME_PATH=

# External host only: Chrome debug port (default: 9333)
# NESTOR_CHROME_DEBUG_PORT=9333

# External host only: run Chrome headless (default: visible browser)
# NESTOR_BROWSER_HEADLESS=1
